# 도메인이 아직 없어서 :80만 연다 (IP로 접속). 나중에 도메인이 생기면
# ":80" 대신 "myapp.com"으로 바꾸기만 하면 Caddy가 HTTPS를 자동으로 붙여준다.
:80 {
	# JS 번들이 원본 크기로 나가면 1/8 OCPU 서버에서 체감 로딩이 크게 느려진다.
	# 압축에 드는 CPU는 무시할 수준이다.
	encode zstd gzip

	# 프론트가 부르는 /api/xxx 를 백엔드의 /xxx 로 그대로 전달한다.
	# (vite.config.ts의 개발 서버 프록시 규칙과 동일하게 맞춘 것 — handle_path가 /api 접두어를 벗겨낸다)
	handle_path /api/* {
		reverse_proxy backend:8080
	}

	# STOMP WebSocket. reverse_proxy가 업그레이드 요청을 알아서 처리한다.
	handle /ws* {
		reverse_proxy backend:8080
	}

	# 나머지는 프론트 정적 파일. React Router가 클라이언트에서 라우팅하므로
	# 못 찾은 경로는 index.html로 넘겨 SPA가 처리하게 한다.
	handle {
		root * /srv/frontend

		# Vite가 파일명에 해시를 붙이므로 /assets 아래는 영구 캐시해도 안전하다.
		# index.html은 캐시하지 않아야 새 배포가 바로 반영된다(Caddy 기본값이 재검증이라 그대로 둔다).
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}
