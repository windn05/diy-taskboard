# 서버에서 이 파일을 .env로 복사하고 실제 값을 채운다. .env는 git에 커밋하지 않는다.
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-random-32-byte-plus-string

# 최초 배포용. 계정이 하나도 없을 때만 이 값으로 관리자 계정을 만든다.
# 로그인해서 비밀번호를 바꾼 뒤에는 아래 두 줄을 지운다.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-at-least-8-chars

# 도메인을 붙이면 여기에 넣는다. Caddy가 인증서를 자동 발급하고 HTTPS로 전환한다.
# 비워두면 http://<공인IP> 로 뜬다. 값에 http:// 같은 접두어는 넣지 않는다.
#SITE_ADDRESS=taskboard.example.com

# 아래는 선택. 주석을 풀면 docker-compose.yml의 기본값을 덮어쓴다.
# 최초 배포로 스키마가 만들어진 뒤에는 validate로 낮춘다.
#JPA_DDL_AUTO=validate
# 인스턴스 메모리에 맞춰 조정한다. 기본값은 1GB 기준.
#JAVA_OPTS=-Xmx2g
